{
  "model_info": {
    "name": "hotwheels_damage_classifier",
    "version": "1.0.0",
    "created_date": "2026-01-15",
    "description": "Multi-output damage classification for Hot Wheels cars"
  },
  
  "architecture": {
    "base_model": "ResNet18",
    "input_shape": [224, 224, 8],
    "quantization": "int8",
    "model_size_mb": 0
  },
  
  "outputs": {
    "severity": {"classes": 5, "labels": ["no_damage", "minor", "moderate", "severe", "missing"]},
    "functional": {"classes": 3, "labels": ["no_impairment", "impaired", "non_functional"]}
  },
  
  "parts": ["axles", "wheels", "frame", "body", "paint"],
  
  "performance": {
    "severity_accuracy": 0.89,
    "functional_accuracy": 0.92,
    "avg_inference_time_ms": 45
  },
  
  "preprocessing": {
    "input_size": [224, 224],
    "normalization": "0-255 uint8",
    "color_space": "RGB"
  }
}
